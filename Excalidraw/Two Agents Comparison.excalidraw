		{
			"id": "hwjVR3TF",
			"type": "text",
			"x": 100,
			"y": 665,
			"width": 4647.26953125,
			"height": 75.6,
			"angle": 0,
			"strokeColor": "#4a1466",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"roundness": null,
			"seed": 113,
			"version": 2,
			"versionNonce": 585373016,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1784522346945,
			"link": null,
			"locked": false,
			"text": "Why this matters: building high agency\n\nAn agent that measures and reports progress every single day is a forcing function — it turns \"we should probably check on outreach\" into a fact someone has to respond to each morning. That's what high agency actually looks like: closing gaps proactively instead of waiting to be told. The Dashboard builds agency by giving us tools to research, decide, and build our own systems by hand. The Slack standup builds agency by creating cheap, daily accountability that never lets momentum quietly die — and because it has almost no setup cost, it's the one we should get running first.",
			"fontSize": 18,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"baseline": 18,
			"containerId": null,
			"originalText": "Why this matters: building high agency\n\nAn agent that measures and reports progress every single day is a forcing function — it turns \"we should probably check on outreach\" into a fact someone has to respond to each morning. That's what high agency actually looks like: closing gaps proactively instead of waiting to be told. The Dashboard builds agency by giving us tools to research, decide, and build our own systems by hand. The Slack standup builds agency by creating cheap, daily accountability that never lets momentum quietly die — and because it has almost no setup cost, it's the one we should get running first.",
			"lineHeight": 1.4,
			"autoResize": true,
			"index": "aC",
			"hasTextLink": false,
			"rawText": ""
		}
