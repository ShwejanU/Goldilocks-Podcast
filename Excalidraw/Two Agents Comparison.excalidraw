		{
			"id": "9pJ6CTkh",
			"type": "text",
			"x": 85,
			"y": 288.8028040277893,
			"width": 528.7354736328125,
			"height": 260,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "a5V",
			"roundness": null,
			"seed": 1746887720,
			"version": 38,
			"versionNonce": 2070630488,
			"isDeleted": false,
			"boundElements": null,
			"updated": 1784522980732,
			"locked": false,
			"text": "• A full workspace we work INSIDE, not just a report we read\n\n• Click tasks, self-assign, add notes per goal right where the work\nhappens\n\n• Outreach + Marketing playbooks live next to the tasks that use\nthem (templates, tactics, tools all in one place)\n\n• Visual progress we can browse anytime: monthly heatmap, weekly\ncontribution bars\n\n• Forces us to build real systems (RSS, hosting, automation), great\nfor deep planning & research-backed decisions",
			"rawText": "• A full workspace we work INSIDE, not just a report we read\n\n• Click tasks, self-assign, add notes per goal right where the work happens\n\n• Outreach + Marketing playbooks live next to the tasks that use them (templates, tactics, tools all in one place)\n\n• Visual progress we can browse anytime: monthly heatmap, weekly contribution bars\n\n• Forces us to build real systems (RSS, hosting, automation), great for deep planning & research-backed decisions",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": "leftbodyrect",
			"originalText": "• A full workspace we work INSIDE, not just a report we read\n\n• Click tasks, self-assign, add notes per goal right where the work happens\n\n• Outreach + Marketing playbooks live next to the tasks that use them (templates, tactics, tools all in one place)\n\n• Visual progress we can browse anytime: monthly heatmap, weekly contribution bars\n\n• Forces us to build real systems (RSS, hosting, automation), great for deep planning & research-backed decisions",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
		{
			"id": "rightbodyrect",
