		{
			"id": "ooPSE1Hg",
			"type": "text",
			"x": 100,
			"y": 220,
			"width": 501.9836556936005,
			"height": 403.2,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
